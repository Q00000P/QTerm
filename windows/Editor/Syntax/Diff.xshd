<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="QDiff" extensions=".diff;.patch" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Added" foreground="#89D185"/>
  <Color name="Removed" foreground="#F48771"/>
  <Color name="Hunk" foreground="#4FA3E3"/>
  <Color name="Comment" foreground="#6A9955" fontStyle="italic"/>
  <RuleSet>
    <Rule color="Hunk">^@@.*$|^(---|\+\+\+) .*$</Rule>
    <Rule color="Added">^\+.*$</Rule>
    <Rule color="Removed">^-.*$</Rule>
    <Rule color="Comment">^(diff|index|Сравнение) .*$</Rule>
  </RuleSet>
</SyntaxDefinition>
