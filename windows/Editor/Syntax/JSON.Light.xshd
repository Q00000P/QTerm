<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="QJSONLight" extensions=".json;.jsonc" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#008000" fontStyle="italic"/>
  <Color name="String" foreground="#A31515"/>
  <Color name="Key" foreground="#0451A5"/>
  <Color name="Number" foreground="#098658"/>
  <Color name="Const" foreground="#0000FF"/>
  <Color name="Punct" foreground="#6E6E6E"/>
  <RuleSet>
    <Span color="Comment" begin="//" />
    <Rule color="Key">"(?:[^"\\]|\\.)*"(?=\s*:)</Rule>
    <Span color="String"><Begin>"</Begin><End>"</End><RuleSet><Span begin="\\" end="."/></RuleSet></Span>
    <Keywords color="Const"><Word>true</Word><Word>false</Word><Word>null</Word></Keywords>
    <Rule color="Number">-?\b\d+(\.\d+)?([eE][+-]?\d+)?\b</Rule>
    <Rule color="Punct">[{}\[\],:]</Rule>
  </RuleSet>
</SyntaxDefinition>
