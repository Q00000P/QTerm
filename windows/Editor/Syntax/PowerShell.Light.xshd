<?xml version="1.0" encoding="utf-8"?>
<SyntaxDefinition name="QPowerShellLight" extensions=".ps1;.psm1;.psd1" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#008000" fontStyle="italic"/>
  <Color name="String" foreground="#A31515"/>
  <Color name="Keyword" foreground="#0000FF"/>
  <Color name="Control" foreground="#AF00DB"/>
  <Color name="Variable" foreground="#001080"/>
  <Color name="Number" foreground="#098658"/>
  <Color name="Func" foreground="#795E26"/>
  <Color name="Type" foreground="#267F99"/>
  <RuleSet>
    <Span color="Comment" multiline="true"><Begin>&lt;#</Begin><End>#&gt;</End></Span>
    <Span color="Comment" begin="#" />
    <Span color="String"><Begin>"</Begin><End>"</End></Span>
    <Span color="String"><Begin>'</Begin><End>'</End></Span>
    <Rule color="Variable">\$[A-Za-z_][\w:]*|\$\{[^}]*\}</Rule>
    <Keywords color="Control"><Word>if</Word><Word>elseif</Word><Word>else</Word><Word>switch</Word><Word>foreach</Word><Word>for</Word><Word>while</Word><Word>do</Word><Word>until</Word><Word>break</Word><Word>continue</Word><Word>return</Word><Word>try</Word><Word>catch</Word><Word>finally</Word><Word>throw</Word><Word>trap</Word><Word>exit</Word><Word>in</Word></Keywords>
    <Keywords color="Keyword"><Word>function</Word><Word>param</Word><Word>begin</Word><Word>process</Word><Word>end</Word><Word>filter</Word><Word>class</Word><Word>enum</Word><Word>using</Word><Word>workflow</Word></Keywords>
    <Rule color="Type">\[[A-Za-z_][\w.\[\]]*\]</Rule>
    <Rule color="Func">\b[A-Z][a-z]+-[A-Za-z]+\b</Rule>
    <Rule color="Number">\b\d+(\.\d+)?\b</Rule>
  </RuleSet>
</SyntaxDefinition>
