<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QTerm</AssemblyName>
    <RootNamespace>QTermWin</RootNamespace>
    <Version>3.11.5</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Per-Monitor V2: чёткий UI и верные координаты на мониторах с разным масштабом -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- SshNet.Agent 2024.2.0.5 объявляет SSH.NET < 2026.0.0; проверяем
         фактическую совместимость в рантайме (см. ConnectAgent) -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <!-- Секреты сборки — не в гите: secrets.local.props (в .gitignore) или переменная окружения
       QTERM_GOOGLE_CLIENT_SECRET (в CI — секрет репозитория). В сборку — как AssemblyMetadata. -->
  <Import Project="secrets.local.props" Condition="Exists('secrets.local.props')" />
  <PropertyGroup>
    <QTermGoogleClientSecret Condition="'$(QTermGoogleClientSecret)' == ''">$(QTERM_GOOGLE_CLIENT_SECRET)</QTermGoogleClientSecret>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(QTermGoogleClientSecret)" />
  </ItemGroup>
  <Target Name="WarnNoGoogleSecret" BeforeTargets="Build" Condition="'$(QTermGoogleClientSecret)' == ''">
    <Warning Text="QTERM_GOOGLE_CLIENT_SECRET не задан (нет secrets.local.props) — вход в Google Drive в этой сборке не работает, WebDAV работает" />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="SshNet.Agent" Version="2024.2.0.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Editor\ — отдельное приложение QEditor.exe со своим csproj: из QTerm его
       исходники исключаем, общий только протокол канала -->
  <ItemGroup>
    <Compile Remove="Editor\**" />
    <Page Remove="Editor\**" />
    <None Remove="Editor\**" />
    <EmbeddedResource Remove="Editor\**" />
    <Compile Include="Editor\Shared\EditorProtocol.cs" Link="Shared\EditorProtocol.cs" />
    <Compile Include="Editor\Shared\ThemeManager.cs" Link="Shared\ThemeManager.cs" />
    <Compile Include="Editor\Shared\WindowFit.cs" Link="Shared\WindowFit.cs" />
  </ItemGroup>

  <!-- dotnet run (Debug): заодно собрать QEditor, чтобы QTerm его нашёл.
       Запущенный QEditor держит свой exe — тогда сборка редактора пропускается
       с предупреждением, QTerm собирается всё равно. -->
  <Target Name="BuildQEditor" BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Debug' And !$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <Exec Command="dotnet build &quot;$(MSBuildProjectDirectory)\Editor\QEditor.csproj&quot; -c Debug -nologo -v:q"
          ContinueOnError="true" />
  </Target>

</Project>
