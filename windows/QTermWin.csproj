<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QTerm</AssemblyName>
    <RootNamespace>QTermWin</RootNamespace>
    <Version>3.16.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Per-Monitor V2: чёткий UI и верные координаты на мониторах с разным масштабом -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- SshNet.Agent 2024.2.0.5 объявляет SSH.NET < 2026.0.0; проверяем
         фактическую совместимость в рантайме (см. ConnectAgent) -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <!-- Секреты сборки — не в гите: secrets.local.props (в .gitignore) или переменная окружения
       QTERM_GOOGLE_CLIENT_SECRET (в CI — секрет репозитория). В сборку — как AssemblyMetadata. -->
  <Import Project="secrets.local.props" Condition="Exists('secrets.local.props')" />
  <PropertyGroup>
    <QTermGoogleClientSecret Condition="'$(QTermGoogleClientSecret)' == ''">$(QTERM_GOOGLE_CLIENT_SECRET)</QTermGoogleClientSecret>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="GoogleClientSecret" Value="$(QTermGoogleClientSecret)" />
  </ItemGroup>
  <Target Name="WarnNoGoogleSecret" BeforeTargets="Build" Condition="'$(QTermGoogleClientSecret)' == ''">
    <Warning Text="QTERM_GOOGLE_CLIENT_SECRET не задан (нет secrets.local.props) — вход в Google Drive в этой сборке не работает, WebDAV работает" />
  </Target>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="SshNet.Agent" Version="2024.2.0.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Каскад: скрипт сервера (qcascade) — один на мак и винду, в корне репо (..\scripts); QTerm заливает его
       на сервер сам. Рабочая копия только windows/ (C:\dev\QTermWin) — берётся scripts\vpn-cascade.sh рядом -->
  <PropertyGroup>
    <CascadeScript Condition="Exists('..\scripts\vpn-cascade.sh')">..\scripts\vpn-cascade.sh</CascadeScript>
    <CascadeScript Condition="'$(CascadeScript)' == '' And Exists('scripts\vpn-cascade.sh')">scripts\vpn-cascade.sh</CascadeScript>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(CascadeScript)" LogicalName="vpn-cascade.sh" Condition="'$(CascadeScript)' != ''" />
  </ItemGroup>
  <Target Name="WarnNoCascadeScript" BeforeTargets="Build" Condition="'$(CascadeScript)' == ''">
    <Error Text="Нет scripts\vpn-cascade.sh ни в ..\scripts, ни в scripts\ — окно «Каскад» без него не соберётся" />
  </Target>

  <!-- Редактор — отдельное приложение QEditor.exe из своего репо (github.com/Q00000P/QEditor);
       QTerm ждёт его рядом с QTerm.exe (publish.cmd копирует из ..\QEditor\windows\publish).
       Общее — Shared\ (протокол канала, тема, окна): копия файлов из QEditor\windows\Shared,
       версия протокола сверяется в hello. -->

</Project>
