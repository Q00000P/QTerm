<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Палитра «Светлая» (QTerm + QEditor). Ключи обязаны совпадать в обеих палитрах -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgBrush" Color="#1B1B1F"/>
    <SolidColorBrush x:Key="DimBrush" Color="#5F6368"/>
    <SolidColorBrush x:Key="BorderDim" Color="#D0D3D8"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="HoverEdge" Color="#B9BDC4"/>
    <SolidColorBrush x:Key="SelBrush" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#C1C4C9"/>
    <SolidColorBrush x:Key="EditorBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabIdleBrush" Color="#E6E7E9"/>
    <SolidColorBrush x:Key="TabActiveEdge" Color="#0067C0"/>
    <!-- вкладки нод в QTerm -->
    <SolidColorBrush x:Key="NodeTabActive" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NodeTabIdle" Color="#E6E7E9"/>
    <SolidColorBrush x:Key="TabIdleEdge" Color="#D0D3D8"/>
    <SolidColorBrush x:Key="DirtyBrush" Color="#C77700"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#FDECEC"/>
    <SolidColorBrush x:Key="DangerEdgeBrush" Color="#E8A0A0"/>
    <SolidColorBrush x:Key="DangerOnBrush" Color="#F4C7C7"/>
</ResourceDictionary>
