<Window x:Class="QTermWin.UI.GitCmdsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Команды Git" Width="940" Height="600" MinWidth="680" MinHeight="420"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Слева: поиск + список по именам -->
        <DockPanel Grid.Column="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <Button Content="＋ Новая" DockPanel.Dock="Right" Click="New_Click" Margin="6,0,0,0"
                        ToolTip="Ctrl+N. Если в буфере команда со ссылкой — подставится сама, имя возьмётся из имени файла; если такая запись уже есть — предложу добавить вариантом"/>
                <TextBox x:Name="SearchBox" Padding="6" TextChanged="Search_Changed"
                         ToolTip="Поиск по имени, заметке и командам. ↑/↓ — выбор, Enter — выполнить"/>
            </DockPanel>
            <ListBox x:Name="List" SelectionChanged="List_SelectionChanged"
                     MouseDoubleClick="List_DoubleClick"
                     ContextMenuOpening="List_ContextMenuOpening"
                     Background="{DynamicResource PanelBrush}"
                     BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu/>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3" ToolTip="{Binding Tip}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Preview}" FontSize="12" Margin="0,1,0,0"
                                       Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Справа: имя / варианты / команда / заметка -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Имя" Foreground="{DynamicResource DimBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" Grid.Row="1" Padding="6" TextChanged="Field_Changed"
                     ToolTip="По имени ищем и выводим в списке. Пусто — возьмётся из имени файла в ссылке"/>

            <DockPanel Grid.Row="2" Margin="0,10,0,4">
                <TextBlock Text="Варианты" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="  Ctrl+1…9 — выбрать" Foreground="{DynamicResource DimBrush}" FontSize="12"
                           VerticalAlignment="Center" Opacity="0.7"/>
            </DockPanel>
            <DockPanel Grid.Row="3">
                <Button Content="✕" DockPanel.Dock="Right" Click="DelVariant_Click" Margin="4,0,0,4" MinWidth="32"
                        ToolTip="Убрать выбранный вариант"/>
                <Button Content="＋ вариант" DockPanel.Dock="Right" Click="AddVariant_Click" Margin="4,0,0,4"
                        ToolTip="Ещё одна команда в эту же запись (например wget вместо curl). Если в буфере команда — подставится"/>
                <WrapPanel x:Name="VarPanel"/>
            </DockPanel>

            <DockPanel Grid.Row="4" Margin="0,6,0,4">
                <TextBlock Text="Метка" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="LabelBox" Padding="5,3" Width="160" HorizontalAlignment="Left"
                         TextChanged="Field_Changed" ToolTip="Короткое имя варианта (curl, wget, с IPv6…)"/>
            </DockPanel>
            <TextBox x:Name="CmdBox" Grid.Row="5" Height="120" Padding="6"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas" FontSize="13"
                     TextChanged="Field_Changed"/>
            <TextBlock Grid.Row="6" Text="Заметка" Foreground="{DynamicResource DimBrush}" Margin="0,10,0,4"/>
            <TextBox x:Name="NoteBox" Grid.Row="7" Padding="6"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top" TextChanged="Field_Changed"/>
        </Grid>

        <!-- Низ -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
            <Button Content="Удалить" DockPanel.Dock="Left" Click="Delete_Click"
                    ToolTip="Удалить всю запись (все варианты). Удаление уедет синком на все устройства"/>
            <Button Content="Выполнить" DockPanel.Dock="Right" Click="Run_Click" Margin="6,0,0,0"
                    Background="{DynamicResource SelBrush}"
                    ToolTip="Enter (в поиске/списке) или Ctrl+Enter — вставить выбранный вариант в терминал и запустить"/>
            <Button Content="Вставить" DockPanel.Dock="Right" Click="Insert_Click" Margin="6,0,0,0"
                    ToolTip="Shift+Enter — вставить в терминал без запуска"/>
            <Button Content="Копировать" DockPanel.Dock="Right" Click="Copy_Click" Margin="6,0,0,0"/>
            <Button Content="Сохранить" DockPanel.Dock="Right" Click="Save_Click" Margin="6,0,0,0"
                    ToolTip="Ctrl+S"/>
            <TextBlock x:Name="Status" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"
                       Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
