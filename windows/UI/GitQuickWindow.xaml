<Window x:Class="QTermWin.UI.GitQuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Команды Git — быстрый вызов" Width="720" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual">
    <Border Margin="16" CornerRadius="10" Padding="10"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderDim}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Поиск -->
            <Grid>
                <TextBox x:Name="SearchBox" FontSize="15" Padding="10,7" TextChanged="Search_Changed"/>
                <TextBlock x:Name="Placeholder" IsHitTestVisible="False" FontSize="15" Margin="14,8,0,0"
                           Foreground="{DynamicResource DimBrush}"
                           Text="Команда Git… (имя, заметка, curl/wget — можно несколько слов)"/>
            </Grid>

            <!-- Список: строка = запись, справа варианты -->
            <ListBox x:Name="List" Margin="0,8,0,0" MaxHeight="430" MinHeight="40"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="List_SelectionChanged"
                     MouseDoubleClick="List_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3" ToolTip="{Binding Tip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Num}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                           Foreground="{DynamicResource FgBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Sub}" FontSize="12" Margin="0,1,0,0"
                                           Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Chips}" VerticalAlignment="Center"
                                          Visibility="{Binding ChipsVisibility}" Margin="8,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Chip" CornerRadius="10" Padding="9,2" Margin="4,0,0,0"
                                                BorderThickness="1" BorderBrush="{DynamicResource BorderDim}"
                                                Background="Transparent" Cursor="Hand"
                                                MouseLeftButtonDown="Chip_MouseDown" Tag="{Binding}"
                                                ToolTip="{Binding Command}">
                                            <TextBlock x:Name="ChipText" Text="{Binding Label}" FontSize="12"
                                                       Foreground="{DynamicResource DimBrush}"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="ChipText" Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="Empty" Margin="6,10,6,4" TextWrapping="Wrap" Visibility="Collapsed"
                       Foreground="{DynamicResource DimBrush}"/>

            <!-- Что именно уйдёт в терминал -->
            <Border x:Name="PreviewBox" Margin="0,8,0,0" Padding="8,6" CornerRadius="6"
                    Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderDim}" BorderThickness="1">
                <TextBlock x:Name="Preview" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                           Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap" MaxHeight="80"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <TextBlock x:Name="Hints" Margin="2,8,2,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource DimBrush}"
                       Text="Enter — выполнить · Shift+Enter — вставить · Tab — вариант · 1…9 — сразу · Ctrl+C — копировать · F2 — изменить · Ctrl+N — новая · Esc"/>
        </StackPanel>
    </Border>
</Window>
