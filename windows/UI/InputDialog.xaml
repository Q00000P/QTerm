<Window x:Class="QTermWin.UI.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QTerm" Width="380" SizeToContent="Height"
        Background="{DynamicResource BgBrush}" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Caption" Foreground="{DynamicResource FgBrush}" Margin="0,0,0,10"
                   TextWrapping="Wrap"/>
        <TextBox x:Name="Box" Padding="6" FontSize="14"
                 Background="{DynamicResource PanelBrush}"
                 Foreground="{DynamicResource FgBrush}"
                 BorderBrush="{DynamicResource BorderDim}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="90"/>
            <Button Content="OK" Click="Ok_Click" MinWidth="90" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
