<Window x:Class="QTermWin.UI.KeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ключи вейлта" Width="640" Height="480"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListView x:Name="KeyList" Grid.Row="0"
                  Background="{DynamicResource PanelBrush}"
                  Foreground="{DynamicResource FgBrush}"
                  BorderBrush="{DynamicResource BorderDim}" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Имя" Width="150" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Тип" Width="110" DisplayMemberBinding="{Binding Type}"/>
                    <GridViewColumn Header="Отпечаток SHA256" Width="330" DisplayMemberBinding="{Binding Fp}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <WrapPanel Grid.Row="1" Margin="0,8,0,0">
            <Button Content="Ключ+ (из файла)" Click="Import_Click" Margin="0,0,6,0"/>
            <Button Content="Копировать authorized_keys" Click="CopyPub_Click" Margin="0,0,6,0"/>
            <Button Content="Копировать отпечаток" Click="CopyFp_Click" Margin="0,0,6,0"/>
            <Button Content="В ssh-agent" Click="ToAgent_Click" Margin="0,0,6,0"
                    ToolTip="Загрузить ключ в OpenSSH-agent на время сессии (для нод с методом «SSH-агент»)"/>
            <Button Content="Удалить" Click="Delete_Click" Margin="0,0,6,0"/>
            <TextBlock x:Name="Status" Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"/>
        </WrapPanel>
    </Grid>
</Window>
