<Window x:Class="QTermWin.UI.NodeAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нода из выделения" Width="900" Height="720" MinWidth="640" MinHeight="520"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListCol" Width="230"/>
            <ColumnDefinition x:Name="GapCol" Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Cap}" Margin="0,0,0,4" Text="Найдено в выделении"/>
            <ListBox x:Name="Items" SelectionChanged="Items_SelectionChanged"
                     Background="{DynamicResource PanelBrush}"
                     BorderBrush="{DynamicResource BorderDim}" BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{DynamicResource DimBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <TextBox x:Name="HeadText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                         Background="Transparent" Foreground="{DynamicResource FgBrush}" FontSize="14"/>

                <TextBlock Style="{StaticResource Cap}" Text="Что это за панель (определяется само по адресу)"/>
                <ComboBox x:Name="TypeBox" SelectionChanged="TypeBox_SelectionChanged">
                    <ComboBoxItem Content="3x-ui"/>
                    <ComboBoxItem Content="AWG · awg-panel (логин + пароль)"/>
                    <ComboBoxItem Content="AWG · старая amnezia-wg-easy (только пароль)"/>
                </ComboBox>

                <Border Margin="0,12,0,0" Padding="10" CornerRadius="6"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderDim}" BorderThickness="1">
                    <StackPanel>
                        <RadioButton x:Name="NewRadio" GroupName="mode" Content="Новая нода" Checked="Mode_Changed"/>
                        <DockPanel Margin="0,8,0,0">
                            <RadioButton x:Name="ReplaceRadio" GroupName="mode" Content="Переустановка — заменить:"
                                         Checked="Mode_Changed" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ReplaceBox" SelectionChanged="ReplaceBox_SelectionChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="ModeNote" Style="{StaticResource Cap}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Cap}" Text="Имя в QTerm"/>
                <TextBox x:Name="NameBox" Padding="6"/>

                <StackPanel x:Name="RolePanel">
                    <TextBlock Style="{StaticResource Cap}" Text="Роль"/>
                    <ComboBox x:Name="XRoleBox" SelectedIndex="0" SelectionChanged="XRoleBox_SelectionChanged">
                        <ComboBoxItem Content="3x-ui · нода"/>
                        <ComboBoxItem Content="3x-ui · главная"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Style="{StaticResource Cap}" Text="Адрес панели (с секретным путём)"/>
                <TextBox x:Name="UrlBox" Padding="6"/>
                <StackPanel x:Name="LoginPanel">
                    <TextBlock x:Name="LoginCap" Style="{StaticResource Cap}" Text="Логин"/>
                    <TextBox x:Name="LoginBox" Padding="6"/>
                </StackPanel>
                <TextBlock x:Name="PassCap" Style="{StaticResource Cap}" Text="Пароль"/>
                <PasswordBox x:Name="PassBox" Padding="6"/>
                <StackPanel x:Name="TwoFaPanel">
                    <TextBlock Style="{StaticResource Cap}" Text="Код 2FA — только если в панели включена двухфакторка"/>
                    <TextBox x:Name="TwoFaBox" Padding="6" Width="160" HorizontalAlignment="Left"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Cap}" Text="Сертификат"/>
                <ComboBox x:Name="TlsBox" SelectedIndex="0">
                    <ComboBoxItem Content="Проверять"/>
                    <ComboBoxItem Content="Не проверять (самоподписанный)"/>
                </ComboBox>

                <CheckBox x:Name="RebindBox" IsChecked="True">
                    <TextBlock x:Name="RebindText" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox x:Name="ConnectBox" IsChecked="True">
                    <TextBlock x:Name="ConnectText" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox x:Name="RecreateBox" IsChecked="True">
                    <TextBlock x:Name="RecreateText" TextWrapping="Wrap"/>
                </CheckBox>

                <StackPanel x:Name="TokenPanel">
                    <TextBlock Style="{StaticResource Cap}"
                               Text="API-токен — выпускается при сохранении (вход по паролю → «Новый токен»), QTerm сразу его пропишет"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Копировать" Click="CopyToken_Click" Margin="8,0,0,0"/>
                        <TextBox x:Name="TokenBox" Padding="6" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"/>
                    </DockPanel>
                </StackPanel>

                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="90"
                         VerticalScrollBarVisibility="Auto" MaxHeight="220"
                         Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource FgBrush}"
                         BorderBrush="{DynamicResource BorderDim}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Закрыть" Click="Close_Click" Margin="0,0,8,0" MinWidth="90"/>
            <Button x:Name="TestButton" Content="Проверить" Click="Test_Click" Margin="0,0,8,0" MinWidth="100"/>
            <Button x:Name="SaveButton" Content="Сохранить" Click="Save_Click" IsDefault="True" MinWidth="130"/>
        </StackPanel>
    </Grid>
</Window>
