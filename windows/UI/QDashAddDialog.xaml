<Window x:Class="QTermWin.UI.QDashAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Хаб QDash — завести устройство" Width="620" SizeToContent="Height" MinHeight="300"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,4"
                   Text="В портале хаба: Настройки → Устройства → «Добавить» (роль — потолок прав этого QTerm). Код живёт десять минут и одноразовый. Пара ключей создаётся здесь, хаб получит только публичную половину."/>
        <TextBlock Style="{StaticResource Cap}" Text="Ссылка из портала (qdash://enroll?…) — вставь целиком, остальное заполнится само"/>
        <TextBox x:Name="LinkBox" Padding="6" TextChanged="Link_Changed"/>
        <TextBlock Style="{StaticResource Cap}" Text="или: адрес хаба (https://host:port) · код · отпечаток серта (sha256, если HTTPS)"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" Grid.Column="0" Padding="6"/>
            <TextBox x:Name="CodeBox" Grid.Column="2" Padding="6" CharacterCasing="Upper" ToolTip="XXXX-XXXX-XX"/>
        </Grid>
        <TextBox x:Name="FpBox" Padding="6" Margin="0,6,0,0" ToolTip="Отпечаток серта хаба: из портала (API → отпечаток) или из ссылки"/>
        <TextBlock Style="{StaticResource Cap}" Text="Имя этого устройства в хабе (пусто — как в приглашении или имя компьютера)"/>
        <TextBox x:Name="NameBox" Padding="6"/>
        <TextBox x:Name="ResultText" Margin="0,10,0,0" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" Padding="0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Click="Cancel_Click" MinWidth="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkBtn" Content="Завести" Click="Ok_Click" MinWidth="120" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
