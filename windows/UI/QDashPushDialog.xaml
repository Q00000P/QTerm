<Window x:Class="QTermWin.UI.QDashPushDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ноды QTerm → в хаб" Width="760" Height="560" MinWidth="640" MinHeight="400"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Выбранные ноды станут серверами хаба. По твоей SSH-сессии каждой ноды QTerm допишет публичный ключ хаба в ~/.ssh/authorized_keys (нода подключится, если не подключена), а в хаб уйдут адрес, порт, пользователь и пин host key — паролей и приватных ключей хаб не получает. Запись в хабе — по id ноды QTerm: повтор обновляет, не дублирует. «Роутер» — Keenetic с Entware (хаб ведёт его как роутер, SSH-порт как в ноде)."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBox x:Name="Status" IsReadOnly="True" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource DimBrush}"
                     VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="300" TextAlignment="Right"/>
            <Button Content="Отмена" Click="Cancel_Click" MinWidth="90" Margin="0,0,8,0" IsCancel="True"/>
            <Button x:Name="OkBtn" Content="В хаб" Click="Ok_Click" MinWidth="120" IsDefault="True"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Все" Click="All_Click" Padding="10,3"/>
            <Button Content="Ни одной" Click="None_Click" Padding="10,3" Margin="6,0,0,0"/>
            <Button Content="Только новые" Click="New_Click" Padding="10,3" Margin="6,0,0,0" ToolTip="Ноды, которых в хабе ещё нет"/>
        </StackPanel>
        <ListView x:Name="NodeList" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource FgBrush}"
                  BorderBrush="{DynamicResource BorderDim}" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding On, Mode=TwoWay}" Margin="0"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Нода" Width="190" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Адрес" Width="230" DisplayMemberBinding="{Binding Addr}"/>
                    <GridViewColumn Header="Host key" Width="80" DisplayMemberBinding="{Binding Pin}"/>
                    <GridViewColumn Header="В хабе" Width="110" DisplayMemberBinding="{Binding InHub}"/>
                    <GridViewColumn Header="Роутер" Width="70">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><CheckBox IsChecked="{Binding Router, Mode=TwoWay}" Margin="0"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
