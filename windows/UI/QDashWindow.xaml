<Window x:Class="QTermWin.UI.QDashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QDash" Width="1220" Height="780" MinWidth="900" MinHeight="560"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Seg" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <!-- выделяемый текст (TextBlock не выделяется) -->
        <Style x:Key="Sel" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DimSel" TargetType="TextBox" BasedOn="{StaticResource Sel}">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
        </Style>
        <Style x:Key="Grid" TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="420"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="140" MinHeight="60"/>
        </Grid.RowDefinitions>

        <!-- ── Хабы ── -->
        <DockPanel Grid.Column="0" Grid.Row="0">
            <TextBlock DockPanel.Dock="Top" Text="Хабы QDash" Style="{StaticResource Head}"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="＋ Хаб…" Click="HubAdd_Click"
                        ToolTip="Завести это устройство в хабе: ссылка qdash://enroll?… или код из портала (Настройки → Устройства)"/>
                <Button Content="Убрать…" Click="HubRemove_Click" Margin="6,0,0,0"
                        ToolTip="Убрать хаб из QTerm (ключ устройства стирается; в портале его лучше отозвать)"/>
            </StackPanel>
            <ListBox x:Name="HubList" SelectionChanged="HubList_Changed"
                     Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource FgBrush}"
                     BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="{Binding Dot}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource DimBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="17,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- ── Хаб ── -->
        <DockPanel Grid.Column="2" Grid.Row="0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="HeadName" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button DockPanel.Dock="Right" Content="Обновить" Click="Refresh_Click" ToolTip="Опросить хаб (F5)"/>
                <TextBox x:Name="HeadStatus" Style="{StaticResource DimSel}"/>
            </DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="SegOverview" Style="{StaticResource Seg}" Content="Обзор" Tag="overview" Click="Seg_Click"/>
                <Button x:Name="SegServers" Style="{StaticResource Seg}" Content="Серверы" Tag="servers" Click="Seg_Click"
                        ToolTip="Серверы (VPS) и роутеры, которые хаб обслуживает по SSH своим ключом"/>
                <Button x:Name="SegJobs" Style="{StaticResource Seg}" Content="Задачи" Tag="jobs" Click="Seg_Click"
                        ToolTip="Задачи хаба (установки, обновления, планы): вывод — вкладкой терминала QTerm"/>
                <Button x:Name="SegDevice" Style="{StaticResource Seg}" Content="Устройство" Tag="device" Click="Seg_Click"
                        ToolTip="Этот QTerm в хабе: ключ, роль, адреса и отпечатки"/>
            </StackPanel>

            <!-- без хаба / без ключа -->
            <Border x:Name="NoHubView" Style="{StaticResource Card}" DockPanel.Dock="Top" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Style="{StaticResource Head}" Text="QDash — единый портал сети"/>
                    <TextBlock Style="{StaticResource Dim}" x:Name="NoHubText"
                               Text="Хаб QDash стоит на домашнем сервере и видит всю сеть целиком: роутеры, клиентов, серверы, подписку 3x-ui и каскад. QTerm подключается к нему своим ключом устройства: в портале хаба — Настройки → Устройства → «Добавить» → скопируй ссылку qdash://enroll?… (или код и адрес) и нажми «＋ Хаб…»."/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="＋ Хаб…" Click="HubAdd_Click" MinWidth="120"/>
                        <Button x:Name="EnrollHereBtn" Content="Завести ключ на этом устройстве…" Click="EnrollHere_Click" Margin="8,0,0,0" Visibility="Collapsed"
                                ToolTip="Хаб приехал синком с другого устройства — у этого QTerm своей пары ключей к нему ещё нет"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="Body">
                <!-- ── Обзор ── -->
                <DockPanel x:Name="OverviewView">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <WrapPanel x:Name="OverviewCards" Orientation="Horizontal"/>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="Роутеры" Style="{StaticResource Head}"/>
                    <ListView x:Name="RouterList" Style="{StaticResource Grid}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="●" Foreground="{Binding Dot}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Роутер" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Модель" Width="170" DisplayMemberBinding="{Binding Model}"/>
                                <GridViewColumn Header="Интернет" Width="150" DisplayMemberBinding="{Binding Internet}"/>
                                <GridViewColumn Header="Клиентов" Width="80" DisplayMemberBinding="{Binding Clients}"/>
                                <GridViewColumn Header="CPU / RAM" Width="100" DisplayMemberBinding="{Binding Load}"/>
                                <GridViewColumn Header="mihomo" Width="130" DisplayMemberBinding="{Binding Mihomo}"/>
                                <GridViewColumn Header="Ноды" Width="80" DisplayMemberBinding="{Binding Nodes}"/>
                                <GridViewColumn Header="Сеть ↓ / ↑ Мбит/с" Width="140" DisplayMemberBinding="{Binding Net}"/>
                                <GridViewColumn Header="Аптайм" Width="110" DisplayMemberBinding="{Binding Uptime}"/>
                                <GridViewColumn Header="Опрос" Width="90" DisplayMemberBinding="{Binding Age}"/>
                                <GridViewColumn Header="Ошибка" Width="300" DisplayMemberBinding="{Binding Error}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <!-- ── Серверы ── -->
                <DockPanel x:Name="ServersView" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="PushBtn" Content="Ноды QTerm → в хаб…" Click="Push_Click"
                                ToolTip="Отдать хабу выбранные ноды: публичный ключ хаба дописывается в authorized_keys ноды по твоей SSH-сессии, в хаб уходят адрес, порт, пользователь и пин host key — без паролей и приватных ключей"/>
                        <Button x:Name="ProbeBtn" Content="Проверить" Click="Probe_Click" Margin="6,0,0,0" ToolTip="Проба выбранного сервера: SSH хабом и что на нём стоит"/>
                        <Button x:Name="InspectBtn" Content="Осмотр" Click="Inspect_Click" Margin="6,0,0,0" ToolTip="Что стоит на сервере по факту (осмотр хаба) — в журнал"/>
                        <Button x:Name="RemoveSrvBtn" Content="Убрать из хаба…" Click="RemoveSrv_Click" Margin="6,0,0,0"/>
                        <TextBox x:Name="ServersStatus" Style="{StaticResource DimSel}" Margin="12,0,0,0"/>
                    </StackPanel>
                    <ListView x:Name="ServerList" Style="{StaticResource Grid}" MouseDoubleClick="ServerList_DoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="●" Foreground="{Binding Dot}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Сервер" Width="160" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Адрес" Width="190" DisplayMemberBinding="{Binding Addr}"/>
                                <GridViewColumn Header="Вход" Width="80" DisplayMemberBinding="{Binding Auth}"/>
                                <GridViewColumn Header="Пинг" Width="60" DisplayMemberBinding="{Binding Ping}"/>
                                <GridViewColumn Header="ОС" Width="150" DisplayMemberBinding="{Binding Os}"/>
                                <GridViewColumn Header="Стоит" Width="260" DisplayMemberBinding="{Binding Stack}"/>
                                <GridViewColumn Header="В QTerm" Width="110" DisplayMemberBinding="{Binding InQTerm}"/>
                                <GridViewColumn Header="Проверено" Width="110" DisplayMemberBinding="{Binding Checked}"/>
                                <GridViewColumn Header="Ошибка" Width="300" DisplayMemberBinding="{Binding Error}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <!-- ── Задачи ── -->
                <DockPanel x:Name="JobsView" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Открыть вкладкой" Click="JobOpen_Click" ToolTip="Вывод задачи — вкладкой терминала QTerm (двойной клик по строке)"/>
                        <Button x:Name="JobKillBtn" Content="Остановить…" Click="JobKill_Click" Margin="6,0,0,0"/>
                        <TextBox x:Name="JobsStatus" Style="{StaticResource DimSel}" Margin="12,0,0,0"/>
                    </StackPanel>
                    <ListView x:Name="JobList" Style="{StaticResource Grid}" MouseDoubleClick="JobList_DoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="" Width="34">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="●" Foreground="{Binding Dot}"/></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Задача" Width="320" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Где" Width="160" DisplayMemberBinding="{Binding Target}"/>
                                <GridViewColumn Header="Статус" Width="120" DisplayMemberBinding="{Binding Status}"/>
                                <GridViewColumn Header="Начата" Width="130" DisplayMemberBinding="{Binding Started}"/>
                                <GridViewColumn Header="Длилась" Width="90" DisplayMemberBinding="{Binding Took}"/>
                                <GridViewColumn Header="Ждёт ввода" Width="200" DisplayMemberBinding="{Binding Prompt}"/>
                                <GridViewColumn Header="Ошибка" Width="300" DisplayMemberBinding="{Binding Error}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <!-- ── Устройство ── -->
                <ScrollViewer x:Name="DeviceView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Head}" Text="Этот QTerm в хабе"/>
                                <TextBlock Style="{StaticResource Cap}" Text="Имя устройства · id"/>
                                <TextBox x:Name="DevName" Style="{StaticResource Sel}"/>
                                <TextBlock Style="{StaticResource Cap}" Text="Роль — потолок прав (меняется в портале: Настройки → Устройства)"/>
                                <TextBox x:Name="DevRole" Style="{StaticResource Sel}"/>
                                <TextBlock Style="{StaticResource Cap}" Text="Публичный ключ устройства (приватный — только здесь, в вейлте, в облако не уходит)"/>
                                <TextBox x:Name="DevPub" Style="{StaticResource Mono}" Height="34"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="UnlockBtn" Content="Открыть окно кодом 2FA…" Click="Unlock_Click"
                                            ToolTip="Если в портале включено «код и на опасное с ключа»: открыть окно опасных действий заранее, а не при первом же действии"/>
                                    <Button Content="Перезавести ключ…" Click="EnrollHere_Click" Margin="8,0,0,0"
                                            ToolTip="Новая пара ключей по новому коду из портала (старое устройство там отзови)"/>
                                    <Button Content="Забыть ключ" Click="ForgetKey_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Head}" Text="Адреса хаба"/>
                                <TextBlock Style="{StaticResource Cap}" Text="Снаружи (канал через VPS или внешний сокет) · отпечаток серта"/>
                                <TextBox x:Name="DevExt" Style="{StaticResource Mono}" Height="52"/>
                                <TextBlock Style="{StaticResource Cap}" Text="В локалке (портал) · отпечаток серта — пробуется первым"/>
                                <TextBox x:Name="DevLan" Style="{StaticResource Mono}" Height="70"/>
                                <TextBlock Style="{StaticResource Cap}" Text="Сейчас ходим"/>
                                <TextBox x:Name="DevActive" Style="{StaticResource Sel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Перечитать адреса из хаба" Click="RefreshAddr_Click"
                                            ToolTip="/api/dev: внешний адрес и локальные адреса с отпечатками"/>
                                    <Button Content="Переименовать хаб…" Click="RenameHub_Click" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" Background="Transparent"/>
        <TextBox x:Name="LogBox" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource Mono}" TextWrapping="Wrap"/>
    </Grid>
</Window>
