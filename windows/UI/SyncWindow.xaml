<Window x:Class="QTermWin.UI.SyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Синхронизация" Width="520" SizeToContent="Height"
        Background="{DynamicResource BgBrush}" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDim}"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="Все устройства смотрят в один файл. Сервер видит только шифротекст (Argon2id + AES-256-GCM). Пароль шифрования должен совпадать на всех устройствах."
                   TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Text="Бекенд"/>
        <ComboBox x:Name="BackendCombo" SelectionChanged="Backend_Changed">
            <ComboBoxItem Content="Google Drive"/>
            <ComboBoxItem Content="WebDAV / Яндекс"/>
        </ComboBox>

        <StackPanel x:Name="GDrivePanel">
            <TextBlock Text="Папка на Диске"/>
            <TextBox x:Name="GdFolderBox" Text="QTerm"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="GoogleButton" Content="Войти в Google" Click="Google_Click"/>
                <TextBlock x:Name="GdStatus" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="WebDavPanel">
            <TextBlock Text="URL файла (Яндекс: https://webdav.yandex.ru/qterm/vault.qtsync)"/>
            <TextBox x:Name="UrlBox"/>
            <TextBlock Text="Логин"/>
            <TextBox x:Name="LoginBox"/>
            <TextBlock Text="Пароль (Яндекс с 2FA — пароль приложения, не основной)"/>
            <PasswordBox x:Name="DavPwBox"/>
        </StackPanel>

        <TextBlock Text="Пароль шифрования (общий для мак/андроид/винда)"/>
        <PasswordBox x:Name="EncPwBox"/>
        <TextBlock Text="Что синхронизируется"/>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderDim}"
                BorderThickness="1" CornerRadius="6" Padding="10,6">
            <TextBlock x:Name="ContentsText" Foreground="{DynamicResource FgBrush}" Margin="0" TextWrapping="Wrap"/>
        </Border>
        <CheckBox x:Name="EnabledBox" Content="Синхронизация включена" Margin="0,12,0,0"
                  Foreground="{DynamicResource FgBrush}"/>

        <DockPanel Margin="0,16,0,0">
            <Button Content="Синк сейчас" Click="SyncNow_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
            <Button Content="Сохранить" Click="Save_Click" DockPanel.Dock="Right" IsDefault="True"/>
            <TextBlock x:Name="StatusLabel" VerticalAlignment="Center" Margin="0"/>
        </DockPanel>
    </StackPanel>
</Window>
