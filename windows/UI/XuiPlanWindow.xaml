<Window x:Class="QTermWin.UI.XuiPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="План" Width="1180" Height="760" MinWidth="820" MinHeight="460"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- ячейка-поле: выделяется и копируется; редактируемое — с рамкой; склеенное — зелёное -->
        <Style x:Key="CellBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editable}" Value="True">
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
                    <Setter Property="ToolTip" Value="Имя можно поправить — применится именно оно"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Merged}" Value="True">
                    <Setter Property="Foreground" Value="#3FB950"/>
                    <Setter Property="ToolTip" Value="Уже сдвоенный: VLESS + Hysteria"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Summary" Grid.Row="0" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DimBrush}">
            <Run Foreground="CornflowerBlue" Text="■ склеить на главной"/><Run Text=" — несколько записей одного устройства станут одной (имя из списка, ключи сохраняются).   "/>
            <Run Foreground="Goldenrod" Text="■ дубль на ноде"/><Run Text=" — на ноде клиент с тем же именем, что на главной.   "/>
            <Run Foreground="MediumSeaGreen" Text="■ новый с ноды"/><Run Text=" — главная заберёт его сама.   "/>
            <Run Foreground="MediumPurple" Text="■ добавить на сервер"/><Run Text=" — клиент появится на этом входящем с теми же ключами и той же подпиской."/>
            <LineBreak/>
            <Run Text="Делается только отмеченное. Имена в рамке можно поправить. "/><Run Foreground="#3FB950" Text="Зелёное"/><Run Text=" — клиент уже сдвоенный (VLESS + Hysteria). Названия входящих (MSK, US3-HYS…) не меняются никогда."/>
        </TextBlock>

        <DockPanel Grid.Row="2" Margin="0,12,0,8">
            <TextBox x:Name="FilterBox" Width="200" Padding="6" Margin="0,0,8,0" TextChanged="Filter_Changed"
                     ToolTip="Фильтр по любому столбцу (S26, FI2, HYS…). «Отметить/Снять все» действуют на видимые строки"/>
            <Button Content="Отметить видимые" Click="All_Click" Margin="0,0,6,0"/>
            <Button Content="Снять видимые" Click="None_Click" Margin="0,0,6,0"/>
            <Button Content="Копировать план" Click="Copy_Click" Margin="0,0,12,0"
                    ToolTip="Весь план текстом в буфер. Ctrl+C — только выделенные строки"/>
            <TextBlock x:Name="Counter" VerticalAlignment="Center" Foreground="{DynamicResource DimBrush}"/>
        </DockPanel>

        <ListView x:Name="List" Grid.Row="3" SelectionMode="Extended"
                  Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource FgBrush}"
                  BorderBrush="{DynamicResource BorderDim}" BorderThickness="1"
                  PreviewKeyDown="List_KeyDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Apply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding Selectable}" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Где" Width="90" DisplayMemberBinding="{Binding Scope}"/>
                    <GridViewColumn Header="Что" Width="230">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate><TextBlock Text="{Binding KindText}" Foreground="{Binding KindBrush}"/></DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="ResultCol" Header="Станет" Width="190">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Result, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding ReadOnly}" FontWeight="SemiBold" MinWidth="160"
                                         Style="{StaticResource CellBox}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn x:Name="FromCol" Header="Сейчас" Width="270">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding From, Mode=OneWay}" IsReadOnly="True" MinWidth="240"
                                         Style="{StaticResource CellBox}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Подробно" Width="380">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Note}" Foreground="{DynamicResource DimBrush}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Note}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <Button x:Name="ApplyBtn" Content="Применить отмеченное" Click="Apply_Click" DockPanel.Dock="Right"
                    IsDefault="True" MinWidth="190"/>
            <Button Content="Отмена" Click="Cancel_Click" DockPanel.Dock="Right" Margin="0,0,8,0" MinWidth="100"/>
            <TextBlock x:Name="Footer" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource DimBrush}"/>
        </DockPanel>
    </Grid>
</Window>
